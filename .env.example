# Trail.AI environment variables.
# Copy to .env and fill in real values:  cp .env.example .env
# Never commit the real .env. Demo mode needs none of these.

# --- Live mode: Strava app credentials (from strava.com/settings/api) ---
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# --- Live mode: session cookie encryption ---
# At least 32 random characters, e.g. the output of:  openssl rand -hex 32
SESSION_SECRET=

# --- AI coach ---
ANTHROPIC_API_KEY=
# Optional model overrides (defaults shown).
# ANTHROPIC_MODEL=claude-sonnet-5-5
# ANTHROPIC_DEMO_MODEL=claude-haiku-4-5-20251001

# --- Optional owner-only personalisation ---
# Added to the coach prompt only when the logged-in Strava athlete id matches
# OWNER_ATHLETE_ID. Never sent to the browser, never used in demo mode.
# OWNER_ATHLETE_ID=
# HR_MAX=
# HR_REST=
# ATHLETE_CONTEXT=

# --- Optional ---
# Canonical site URL used to build the Strava OAuth redirect
# (defaults to the request host).
# APP_URL=https://trail-dashboard-one.vercel.app
